{
  "name": "nterminal",
  "private": true,
  "version": "0.4.8",
  "type": "module",
  "description": "N-Terminal - gruplanabilir sekmeli terminal (Windows, macOS): oturum devamliligi, komut gecmisi, ayar import/export",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/run.mjs dev",
    "bundle": "node scripts/run.mjs build",
    "test": "node scripts/run.mjs test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/primitive": "^4.5.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
