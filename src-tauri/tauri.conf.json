{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "N-Terminal",
  "version": "0.3.2",
  "identifier": "com.nyayan.nterminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "N-Terminal",
        "width": 1480,
        "height": 920,
        "minWidth": 760,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "preventOverflow": true,
        "decorations": false,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "publisher": "Nurullah YAYAN",
    "copyright": "© 2026 Nurullah YAYAN",
    "category": "DeveloperTool",
    "shortDescription": "Gruplanabilir sekmeli terminal",
    "longDescription": "N-Terminal: gruplar ve gruplara bagli terminal sekmeleri, oturum devamliligi, komut gecmisi ve ayar aktarimi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "template": "wix/main.wxs"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMDAxNjIyNkMzMDhGREMKUldUY2p6QnNJaFlBSGJpbzBFSTZEODk3KzBhMCtJc0dsSHk1S3padlZTOXFwLzN1UW9kVlZ4aSsK",
      "endpoints": [
        "https://github.com/NYAYAN/NTerminal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
